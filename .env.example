# Copy to .env.local. Do not put real secrets in this file.
# Leave the Supabase values empty to run the labelled demonstration.
# Demonstration mode does not save reports, messages or uploads.

# Force the demonstration even if credentials are present: demo
# Leave unset to use live mode only when all three Supabase values exist.
DRIVERSVOICE_MODE=

# Server-only. Do not prefix these with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used for sign-in links and sitemap URLs. No trailing path.
SITE_URL=https://driversvoice.ie

# Transactional email. If empty, the app records that mail was not sent.
RESEND_API_KEY=
EMAIL_FROM=

# Required before document uploads can be considered. Leave unset.
UPLOADS_ENABLED=
SCANNER_WEBHOOK_SECRET=

# Salt for rate-limit keys. Use a long random string in any deployed environment.
RATE_LIMIT_SALT=

# Signs demonstration cookies. Use a long random string if a demo is reachable online.
DEMO_SESSION_SECRET=

# Protects the reminder route. Vercel cron should send Authorization: Bearer <secret>.
CRON_SECRET=

# Dev-only design controls. Leave unset for the driver-facing site.
NEXT_PUBLIC_DESIGN_PANEL=

# Public WhatsApp desk. International form, for example +353871234567.
# Leave empty until the forum number is ready. The button stays on the site either way.
NEXT_PUBLIC_WHATSAPP_NUMBER=
